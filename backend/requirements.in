# Backend libraries, with the range of versions we accept.
# Install:  pip install -r backend/requirements-dev.in
# Then lock the exact versions you got:  pip freeze > backend/requirements.txt
# (later stages add Flask-JWT-Extended, Flask-Limiter, Pydantic, psycopg and gunicorn)

Flask>=3.1,<3.2                # web framework: routes, requests, responses
Flask-SQLAlchemy>=3.1,<3.2     # connects SQLAlchemy to Flask (one session per request)
SQLAlchemy>=2.0.45,<2.1        # database models and queries (2.0.45+ supports Python 3.14)
Flask-Migrate>=4.1,<5          # `flask db ...` commands: versioned, safe database changes (Alembic)
python-dotenv>=1.1,<2          # reads backend/.env into environment variables
numpy>=2.0,<3                  # the Disciplina engine in llm/
