# Copy this file to backend/.env and change what you need. backend/.env is git-ignored:
# never commit it, and never put real secrets in .env.example.

# development (default) | production  (tests always use "testing")
FLASK_CONFIG=development

# Database. Leave empty to use the SQLite file backend/instance/disciplina.db.
# PostgreSQL (e.g. Neon) looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Secret key for signing cookies and tokens. Development: leave empty and one is created for you
# in backend/instance/secret_key. Production: REQUIRED, 64 random characters, made with
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Secret key for login tokens. Same rules as SECRET_KEY, and it must be a DIFFERENT value.
JWT_SECRET_KEY=

# Allow starting training runs from the web app (true on your laptop, false on free hosting).
TRAINING_ENABLED=true

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
